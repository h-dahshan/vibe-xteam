# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development # Environment: development|staging|production|test
APP_NAME=my-app # Application display name
APP_VERSION=1.0.0 # Semantic version (x.y.z)
APP_URL=http://localhost:3000 # Public-facing application URL

# API Configuration
API_PREFIX=api # API route prefix (e.g., /api/v1)
API_VERSION=v1 # API version identifier

# Internationalization
LOCALES_SUPPORTED=en,es # Comma-separated language codes
LOCALES_DEFAULT=en # Default language code
LOCALES_FALLBACK=en # Fallback when translation missing

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# CORS Configuration
CORS_ORIGIN=http://localhost:3000 # Allowed origins (comma-separated for multiple)

# Password Hashing
BCRYPT_SALT_ROUNDS=12 # Password hashing complexity (10-15 recommended)

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars # Min 32 chars, use strong random string
JWT_EXPIRES_IN=3600 # Access token expiry in seconds (3600 = 1 hour)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-32chars # Min 32 chars, different from JWT_SECRET
JWT_REFRESH_EXPIRES_IN=604800 # Refresh token expiry in seconds (604800 = 7 days)

# Rate Limiting
RATE_LIMIT_TTL=60 # Time window in seconds
RATE_LIMIT_MAX_HITS=100 # Max requests per time window
RATE_LIMIT_MAX_HITS_PER_IP=10 # Max requests per IP per time window

# =============================================================================
# WEBSOCKET & REAL-TIME
# =============================================================================
WEBSOCKET_PORT=3001 # WebSocket server port (1024-65535)
WEBSOCKET_CORS_ORIGIN=http://localhost:3000 # WebSocket allowed origins

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Supabase PostgreSQL
SUPABASE_DATABASE_URL=postgresql://user:pass@localhost:5432/mydb # Connection pool URL
SUPABASE_DIRECT_URL=postgresql://user:pass@localhost:5432/mydb # Direct connection URL (migrations)

# =============================================================================
# FILE STORAGE & UPLOADS
# =============================================================================
# File Upload Configuration
MAX_FILE_SIZE=10485760 # Max upload size in bytes (10485760 = 10MB)
ALLOWED_FILE_TYPES=jpg,png,pdf,doc,docx # Comma-separated file extensions

# Local Storage (Development)
LOCAL_STORAGE_PATH=./uploads # Local directory for file uploads

# Supabase S3 Storage (Production)
SUPABASE_S3_REGION=us-east-1 # AWS S3 region
SUPABASE_S3_BUCKET=my-bucket # S3 bucket name
SUPABASE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com # S3 endpoint URL
SUPABASE_S3_ACCESS_KEY=your-access-key # S3 access key ID
SUPABASE_S3_ACCESS_KEY_SECRET=your-secret-key # S3 secret access key

# =============================================================================
# COMMUNICATION SERVICES
# =============================================================================
# Resend Email Service
RESEND_API_KEY=re_your_api_key # Resend API key (starts with re_)
RESEND_FROM_EMAIL=hello@example.com # Sender email address (must be verified)
RESEND_FROM_NAME=My App # Sender display name

# Twilio SMS Service
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx # Twilio Account SID (starts with AC)
TWILIO_AUTH_TOKEN=your-auth-token # Twilio Auth Token
TWILIO_PHONE_NUMBER=+1234567890 # Twilio phone number (E.164 format)

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Connection
REDIS_URL=redis://localhost:6379 # Redis connection URL
REDIS_PASSWORD=optional-password # Redis password (leave empty if none)
REDIS_DB=0 # Default Redis database (0-15)
REDIS_TTL=3600 # Default TTL in seconds (3600 = 1 hour)

# Redis Database Allocation
REDIS_SESSION_DB=1 # Database for user sessions (0-15)
REDIS_RATE_LIMIT_DB=2 # Database for rate limiting (0-15)
REDIS_QUEUE_DB=3 # Database for job queues (0-15)

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_TTL=3600 # Cache TTL in seconds (3600 = 1 hour)
CACHE_MAX_ITEMS=1000 # Maximum cached items
CACHE_COMPRESSION=true # Enable cache compression (true|false)

# =============================================================================
# QUEUES
# =============================================================================
# Job Processing
QUEUE_CONCURRENCY=5 # Concurrent job processing limit
QUEUE_MAX_RETRIES=3 # Maximum retry attempts for failed jobs
QUEUE_DELAY_RETRY=1 # Retry delay in seconds

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================
CIRCUIT_BREAKER_TIMEOUT=10 # Request timeout in seconds
CIRCUIT_BREAKER_ERROR_THRESHOLD=5 # Errors before circuit opens
CIRCUIT_BREAKER_RESET_TIMEOUT=60 # Circuit reset time in seconds

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Logging Configuration
LOG_SERVICE_NAME=my-app # Service name in logs
LOG_LEVEL=info # Log level: error|warn|info|debug|verbose

LOG_TRANSPORT=stdout # Log output: stdout|otlp|both
LOG_FORMAT=otel-json # Log format: otel-json|winston

# Logging Security
LOG_REDACT_PATTERNS=password,token,secret,key,authorization # Comma-separated patterns to redact
LOG_MAX_MESSAGE_LENGTH=10000 # Max log message length in characters

# Logs Buffering for OTLP
LOG_MEM_BUFFER_ENTRIES=1000 # Buffer entries count
LOG_MEM_BUFFER_FLUSH_INTERVAL=5 # Buffer flush interval in seconds
LOG_BUFFER_FILE_PATH=./logs/otlp-buffer # Buffer file path for OTLP logs
LOG_BUFFER_FILE_MAX_SIZE=10485760 # Max log file size in bytes (10485760 = 10MB)
LOG_BUFFER_FILE_DATE_PATTERN=YYYY-MM-DD # Log file date pattern
LOG_BUFFER_MAX_FILES=5 # Max number of log files to retain

# OpenTelemetry
OTEL_SERVICE_NAME=my-app # Service name for traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf # OTLP protocol: grpc|http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com # OTLP collector endpoint
OTEL_EXPORTER_OTLP_TIMEOUT=5 # Export timeout in seconds
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer token # Optional headers (key=value,key2=value2)

# Sentry Error Tracking
SENTRY_DSN=https://xxx@sentry.io/xxx # Sentry DSN URL
SENTRY_ENVIRONMENT=development # Environment name in Sentry

# =============================================================================
# HEALTH CHECKS & MONITORING
# =============================================================================
HEALTH_CHECK_TIMEOUT=5 # Health check timeout in seconds
HEALTH_CHECK_DATABASE=true # Enable database health check (true|false)
HEALTH_CHECK_REDIS=true # Enable Redis health check (true|false)
HEALTH_CHECK_EXTERNAL_SERVICES=true # Enable external services check (true|false)

# =============================================================================
# BUSINESS CONFIGURATION
# =============================================================================
# Timezone
DEFAULT_TIMEZONE=UTC # Default timezone for the application
BUSINESS_TIMEZONE=America/New_York # Business hours timezone