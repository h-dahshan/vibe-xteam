# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development # [REQ] Environment: development|staging|production - NO others
APP_NAME=my-app # [REQ] Application display name
APP_VERSION=1.0.0 # [REQ] Semantic version (x.y.z)
APP_URL=http://localhost:3000 # [REQ] Public-facing application URL

# API Configuration
API_PREFIX=api # [REQ] API route prefix (e.g., /api/v1)
API_VERSION=v1 # [REQ] API version identifier

# Internationalization
LOCALES_SUPPORTED=en,es # [OPT] Comma-separated language codes (default: en)
LOCALES_DEFAULT=en # [OPT] Default language code (default: en)
LOCALES_FALLBACK=en # [OPT] Fallback when translation missing (default: en)

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# CORS Configuration
CORS_ORIGIN=http://localhost:3001 # [REQ] Allowed origins (comma-separated for multiple)

# Password Hashing
BCRYPT_SALT_ROUNDS=12 # [OPT] Password hashing complexity (default: 12, range: 10-15)

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars # [REQ] Min 32 chars, use strong random string
JWT_EXPIRES_IN=3600 # [OPT] Access token expiry in seconds (3600 = 1 hour)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-32chars # [REQ] Min 32 chars, different from JWT_SECRET
JWT_REFRESH_EXPIRES_IN=604800 # [OPT] Refresh token expiry in seconds (604800 = 7 days)

# Rate Limiting
RATE_LIMIT_TTL=60 # [OPT] Time window in seconds (default: 60)
RATE_LIMIT_MAX_HITS=100 # [OPT] Max requests per time window (default: 100)
RATE_LIMIT_MAX_HITS_PER_IP=10 # [OPT] Max requests per IP per time window (default: 10)

# =============================================================================
# WEBSOCKET & REAL-TIME
# =============================================================================
WEBSOCKET_PORT=3010 # [OPT] WebSocket server port (default: 3010, range: 1024-65535)
WEBSOCKET_CORS_ORIGIN=http://localhost:3001 # [REQ] WebSocket allowed origins (comma-separated for multiple)

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Supabase PostgreSQL
SUPABASE_DATABASE_URL=postgresql://user:pass@localhost:5432/mydb # [REQ] Connection pool URL
SUPABASE_DIRECT_URL=postgresql://user:pass@localhost:5432/mydb # [REQ] Direct connection URL (migrations)

# =============================================================================
# FILE STORAGE & UPLOADS
# =============================================================================
# File Upload Configuration
MAX_FILE_SIZE=10485760 # [OPT] Max upload size in bytes (10485760 = 10MB)
ALLOWED_FILE_TYPES=jpg,png,pdf,doc,docx # [OPT] Comma-separated file extensions

# Local Storage (Development)
LOCAL_STORAGE_PATH=./uploads # [OPT] Local directory for file uploads

# Supabase S3 Storage (Production)
SUPABASE_S3_REGION=us-east-1 # [REQ] AWS S3 region 
SUPABASE_S3_BUCKET=my-bucket # [REQ] S3 bucket name 
SUPABASE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com # [REQ] S3 endpoint URL 
SUPABASE_S3_ACCESS_KEY=your-access-key # [REQ] S3 access key ID 
SUPABASE_S3_ACCESS_KEY_SECRET=your-secret-key # [REQ] S3 secret access key 

# =============================================================================
# COMMUNICATION SERVICES
# =============================================================================
# Resend Email Service
RESEND_API_KEY=re_your_api_key # [REQ] Resend API key (starts with re_)
RESEND_FROM_EMAIL=hello@example.com # [REQ] Sender email address (must be verified)
RESEND_FROM_NAME=My App # [REQ] Sender display name

# Twilio SMS Service
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx # [REQ] Twilio Account SID (starts with AC)
TWILIO_AUTH_TOKEN=your-auth-token # [REQ] Twilio Auth Token
TWILIO_PHONE_NUMBER=+1234567890 # [REQ] Twilio phone number (E.164 format)

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Connection
REDIS_URL=redis://localhost:6379 # [REQ] Redis connection URL
REDIS_PASSWORD=optional-password # [REQ] Redis password

# Redis Database Allocation
REDIS_DB=0 # [OPT] Default Redis database (default: 0, range: 0-15)
REDIS_SESSION_DB=1 # [OPT] Database for user sessions (default: 1, range: 0-15)
REDIS_RATE_LIMIT_DB=2 # [OPT] Database for rate limiting (default: 2, range: 0-15)
REDIS_QUEUE_DB=3 # [OPT] Database for job queues (default: 3, range: 0-15)

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_TTL=3600 # [OPT] Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_MAX_ITEMS=1000 # [OPT] Maximum cached items (default: 1000)
CACHE_COMPRESSION=true # [OPT] Enable cache compression (default: true)

# =============================================================================
# QUEUES
# =============================================================================
# Job Processing
QUEUE_CONCURRENCY=5 # [OPT] Concurrent job processing limit (default: 5)
QUEUE_MAX_RETRIES=3 # [OPT] Maximum retry attempts for failed jobs (default: 3)
QUEUE_DELAY_RETRY=30 # [OPT] Retry delay in seconds (default: 30)

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================
CIRCUIT_BREAKER_TIMEOUT=10 # [OPT] Request timeout in seconds (default: 10)
CIRCUIT_BREAKER_ERROR_THRESHOLD=5 # [OPT] Errors before circuit opens (default: 5)
CIRCUIT_BREAKER_RESET_TIMEOUT=60 # [OPT] Circuit reset time in seconds (default: 60)

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Logging Configuration
LOG_SERVICE_NAME=my-app # [REQ] Service name in logs
LOG_LEVEL=info # [OPT] Log level: error|warn|info|debug|verbose (default: info)

LOG_TRANSPORT=stdout # [OPT] Log output: stdout|otlp|both (default: stdout)
LOG_FORMAT=otel-json # [OPT] Log format: otel-json|winston (default: otel-json)

# Logging Security
LOG_REDACT_PATTERNS=password,token,secret,key,authorization # [OPT] Comma-separated patterns to redact (default shown)
LOG_MAX_MESSAGE_LENGTH=10000 # [OPT] Max log message length in characters (default: 10000)

# Logs Buffering for OTLP
LOG_MEM_BUFFER_ENTRIES=1000 # [OPT] Buffer entries count (default: 1000)
LOG_MEM_BUFFER_FLUSH_INTERVAL=5 # [OPT] Buffer flush interval in seconds (default: 5)
LOG_BUFFER_FILE_PATH=./logs/otlp-buffer # [OPT] Buffer file path for OTLP logs (default: ./logs/otlp-buffer)
LOG_BUFFER_FILE_MAX_SIZE=10485760 # [OPT] Max log file size in bytes (default: 10485760 = 10MB)
LOG_BUFFER_FILE_DATE_PATTERN=YYYY-MM-DD # [OPT] Log file date pattern (default: YYYY-MM-DD)
LOG_BUFFER_MAX_FILES=5 # [OPT] Max number of log files to retain (default: 5)

# OpenTelemetry
OTEL_SERVICE_NAME=my-app # [REQ] Service name for traces
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com # [REQ] OTLP collector endpoint
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf # [OPT] OTLP protocol: grpc|http/protobuf (default: http/protobuf)
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer token,X-Custom=value" # [OPT] Headers (comma-separated key=value pairs)
OTEL_EXPORTER_OTLP_TIMEOUT=5 # [OPT] Export timeout in seconds (default: 5)

# Sentry Error Tracking
SENTRY_DSN=https://xxx@sentry.io/xxx # [REQ] Sentry DSN URL
SENTRY_ENVIRONMENT=development # [REQ] Environment name in Sentry

# =============================================================================
# HEALTH CHECKS & MONITORING
# =============================================================================
HEALTH_CHECK_TIMEOUT=5 # [OPT] Health check timeout in seconds (default: 5)
HEALTH_CHECK_DATABASE=true # [OPT] Enable database health check (default: true)
HEALTH_CHECK_REDIS=true # [OPT] Enable Redis health check (default: true)
HEALTH_CHECK_EXTERNAL_SERVICES=true # [OPT] Enable external services check (default: true)

# =============================================================================
# BUSINESS CONFIGURATION
# =============================================================================
# Timezone
DEFAULT_TIMEZONE=UTC # [OPT] Default timezone for the application (default: UTC)
BUSINESS_TIMEZONE=America/New_York # [OPT] Business hours timezone (default: America/New_York)